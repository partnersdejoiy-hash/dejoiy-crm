# Dejoiy CRM (Twenty) — private deployment
# Copy to .env and adjust:  cp .env.example .env

# --- Public URL ---
SERVER_URL=https://hub.dejoiy.com

# --- Database (isolated inside this compose project; not exposed publicly) ---
PG_DATABASE_USER=dejoiy_crm
PG_DATABASE_PASSWORD=CHANGE_ME
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432
PG_DATABASE_NAME=dejoiy_crm
REDIS_URL=redis://redis:6379

# --- Secrets (generate fresh: openssl rand -hex 32) ---
ENCRYPTION_KEY=CHANGE_ME
FALLBACK_ENCRYPTION_KEY=CHANGE_ME
APP_SECRET=CHANGE_ME

# --- Privacy: no telemetry phone-home ---
TELEMETRY_ENABLED=false

# --- Storage: local volume ---
STORAGE_TYPE=local

# --- Advanced (leave commented unless you need them) ---
# DISABLE_DB_MIGRATIONS=false
# DISABLE_CRON_JOBS_REGISTRATION=false
# TAG=latest
# Dejoiy-branded image built by .github/workflows/build-dejoiy-image.yaml
# (rollback: remove these two lines to use upstream twentycrm/twenty:latest)
IMAGE_REPO=ghcr.io/partnersdejoiy-hash/dejoiy-crm
TAG=latest
